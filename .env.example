# Motor de respostas: "keyword" (defeito, grátis, respostas curadas)
# ou "llm" (provider OpenAI-compatible).
ANSWER_ENGINE=keyword

# ---- Providers LLM grátis (só usado com ANSWER_ENGINE=llm) ----
# Todos têm endpoint OpenAI-compatible — basta criar conta e gerar API key.
# Atenção: nos tiers grátis, os pedidos podem ser usados para treino dos
# modelos — por isso o Zé nunca pede dados pessoais. Vê /privacidade.

# Groq (free tier generoso, muito rápido — recomendado):
#   https://console.groq.com -> API Keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b

# OpenRouter (modelos com sufixo :free, ~50 pedidos/dia):
#   https://openrouter.ai -> Keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Google Gemini (free tier, via endpoint OpenAI-compatible):
#   https://aistudio.google.com -> Get API key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash

# Modelo de reserva (opcional): se LLM_MODEL falhar (deprecado, 429...),
# tenta este antes de cair no KeywordEngine.
# LLM_MODEL_FALLBACK=openai/gpt-oss-20b

# Timeout do pedido ao provider (ms). Opcional, defeito 20000.
# LLM_TIMEOUT_MS=20000

# ---- Proteção da rota /api/responder ----
# Pedidos por IP: defeito 20 por 10 minutos (429 + Retry-After acima disso).
# RATE_LIMIT_PER_IP=20
# RATE_LIMIT_WINDOW_MS=600000
# Teto global diário de chamadas ao LLM: acima disto o site responde
# sempre com o motor de keywords (degradação graciosa, sem erro).
# MAX_LLM_CALLS_PER_DAY=500
# Sal para a hash dos IPs (muda para um valor teu em produção).
# RATE_LIMIT_SALT=valor-aleatorio-longo
